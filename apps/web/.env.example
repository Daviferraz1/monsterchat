# Supabase (Públicas - usadas no cliente)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Supabase (Privadas - apenas servidor)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Meta App (Privadas - apenas servidor)
META_APP_SECRET=seu-app-secret
META_WEBHOOK_VERIFY_TOKEN=meu_token_secreto_123

# WhatsApp (Privadas - apenas servidor)
WHATSAPP_PHONE_NUMBER_ID=247994065074259
WHATSAPP_ACCESS_TOKEN=seu-token-aqui
WHATSAPP_WABA_ID=285585611312219

# Rastreamento de campanhas: número para redirecionamento na página /r (ex.: 5511999999999)
# Opcional; pode ser passado na URL: /r?redirect_wa=5511999999999
NEXT_PUBLIC_WHATSAPP_REDIRECT_NUMBER=5531996917394

# Facebook Pixel + Conversions API (atribuição no Ads Manager)
# Pixel: ID do seu Pixel no Events Manager. CAPI: token em Configurações do Pixel > Conversions API
NEXT_PUBLIC_FB_PIXEL_ID=
FB_CAPI_ACCESS_TOKEN=

# Instagram (Privadas - apenas servidor)
INSTAGRAM_PAGE_ID=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_APP_ID=

# API MonsterChat (Express) – obrigatório para canal "WhatsApp (QR / Baileys)"
# Ex.: http://localhost:3001 em dev; https://sua-api.railway.app em produção
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
